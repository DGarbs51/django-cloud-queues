# Local settings. Copy to .env (gitignored) and run every command with: uv run --env-file .env ...
# On Laravel Cloud these come from the environment; the app never reads .env itself.

# Cloud generates SECRET_KEY for each environment. Locally settings.py falls back to an insecure key.
# SECRET_KEY=change-me

# Queue backend for local runs. On Cloud the managed queue selects managed mode; leave this unset there.
LARAVEL_CLOUD_QUEUES_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379/3
# Own key namespace on the shared local Redis (python-cloud-queues uses lcq-demo: on DB 0).
DEMO_KEY_PREFIX=django-demo:

# Cloud injects DATABASE_URL (mysql:// or postgresql://) when a database is attached. `manage.py migrate` needs it.
DATABASE_URL=mysql://root@127.0.0.1:3306/django_cloud_queues

# Cloud sets PORT and WEB_CONCURRENCY; two workers, like the ASGI environments.
PORT=8003
WEB_CONCURRENCY=2

LOG_LEVEL=INFO
# Terminal output is readable lines, piped output is JSON. Force one with json or line.
# LOG_FORMAT=line
PYTHONUNBUFFERED=1

# Optional. Set to 0 to encrypt DB connections without verifying the server certificate
# (Cloud sets this for its self-signed database proxy). Used by the Database check.
# DB_SSL_VERIFY=0
